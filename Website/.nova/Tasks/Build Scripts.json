{
  "actions" : {
    "build" : {
      "script" : "\\. \"$HOME\/.nvm\/nvm.sh\"\nnode_modules\/.bin\/webpack\nnode_modules\/.bin\/sass --style compressed --no-source-map src\/scss:www\/assets\/css",
      "shell" : "\/bin\/bash"
    },
    "run" : {
      "script" : "trap \"trap - SIGTERM && kill -- -$$\" SIGHUP SIGINT SIGTERM EXIT\n.\/build.sh --watch",
      "shell" : "\/bin\/bash"
    }
  },
  "openLogOnRun" : "start",
  "serverName" : "Beacon Local Server"
}
