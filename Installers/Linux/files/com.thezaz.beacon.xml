<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
	<mime-type type="application/x-beacon-document">
		<comment>Beacon Project</comment>
		<icon name="com.thezaz.beacon.document" />
		<glob pattern="*.beacon" />
		<magic priority="50">
			<match type="bequad" value="3470482855257601832" offset="0" />
		</magic>
	</mime-type>
	<mime-type type="application/x-beacon-preset">
		<comment>Beacon Template</comment>
		<icon name="com.thezaz.beacon.preset" />
		<glob pattern="*.beacontemplate" />
	</mime-type>
	<mime-type type="application/x-beacon-script">
		<comment>Beacon Script</comment>
		<icon name="com.thezaz.beacon.script" />
		<glob pattern="*.beaconscript" />
	</mime-type>
	<mime-type type="application/x-beacon-updatedelta">
		<comment>Beacon Data Update</comment>
		<icon name="com.thezaz.beacon.updatedelta" />
		<glob pattern="*.beacondata" />
	</mime-type>
</mime-info>
